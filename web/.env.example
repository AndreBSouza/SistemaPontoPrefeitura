# Base da API (em dev, o Vite faz proxy de /api -> http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# ── Login Keycloak (OIDC) ────────────────────────────────────────────────────
# Defina AUTHORITY + CLIENT_ID para ATIVAR o login via Keycloak. Ausentes, o app
# usa o login dev (Tenant ID + papéis manuais) — nada muda.
#
# AUTHORITY = URL do realm (issuer). Ex.: http://localhost:8081/realms/ponto
# CLIENT_ID = client PÚBLICO (Standard Flow + PKCE S256) com redirect <origin>/callback
# O JWT emitido deve trazer o claim `tenant_id`; os papéis vêm de `realm_access.roles`.
#VITE_OIDC_AUTHORITY=http://localhost:8081/realms/ponto
#VITE_OIDC_CLIENT_ID=ponto-web
# Opcionais (default = <origin>/callback e <origin>):
#VITE_OIDC_REDIRECT=http://localhost:5173/callback
#VITE_OIDC_POST_LOGOUT=http://localhost:5173/login
