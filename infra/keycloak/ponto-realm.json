  "_comment_authentication": "Fluxo de browser customizado 'browser-mfa' definido como fluxo de login padrao do realm (browserFlow). Ele replica o fluxo padrao do Keycloak, mas troca o passo de OTP por um sub-fluxo CONDITIONAL: o executor 'conditional-user-role' verifica se o usuario possui um dos roles administrativos (rh, controladoria, tenant-admin, operador) e, em caso afirmativo, o 'auth-otp-form' passa a ser REQUIRED. Para esses usuarios, se ainda nao houver um OTP cadastrado, o Keycloak dispara automaticamente o required action CONFIGURE_TOTP. Servidores e gestores nao caem na condicao e seguem apenas com usuario/senha.",
  "authenticationFlows": [
    {
      "alias": "browser-mfa",
      "description": "Fluxo de browser com MFA/OTP condicional para perfis administrativos (rh, controladoria, tenant-admin, operador)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "flowAlias": "browser-mfa forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
