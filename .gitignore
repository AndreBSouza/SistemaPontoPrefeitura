key.properties
*.jks
*.keystore
# Certificados (e-CNPJ ICP-Brasil para assinar o AFD, TLS, etc.)
*.p12
*.pfx
*.pem
# Credenciais de serviços externos
*service-account*.json
google-services.json
GoogleService-Info.plist
# Terraform (state guarda segredos em texto claro)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars.local

# Logs / temporarios
*.log
_in008_*.txt

# Artefatos de build do app — regeneraveis com `flutter build apk/appbundle`
# (o GitHub rejeita arquivos acima de 100 MB; o APK de debug passa de 190 MB)
*.apk
*.aab
*.ipa
